<%- include("../partials/header", { user: user }) %>

<h2><%= supplier ? "Sửa nhà cung cấp" : "Thêm nhà cung cấp" %></h2>
<form action="<%= supplier ? '/suppliers/edit/' + supplier._id : '/suppliers/add' %>" method="POST">
  <label>Tên:</label>
  <input type="text" name="name" value="<%= supplier ? supplier.name : '' %>" required><br>
  <label>Địa chỉ:</label>
  <input type="text" name="address" value="<%= supplier ? supplier.address : '' %>" required><br>
  <label>Điện thoại:</label>
  <input type="text" name="phone" value="<%= supplier ? supplier.phone : '' %>" required><br>
  <button type="submit"><%= supplier ? "Cập nhật" : "Thêm" %></button>
</form>

<%- include("../partials/footer") %>
