<%- include("../partials/header", { user: user }) %>

<h2>Danh sách sản phẩm</h2>
<a href="/products/add">Thêm sản phẩm</a>
<table border="1">
  <thead>
    <tr>
      <th>Tên</th>
      <th>Giá</th>
      <th>Số lượng</th>
      <th>Nhà cung cấp</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody>
    <% products.forEach(p => { %>
      <tr>
        <td><%= p.name %></td>
        <td><%= p.price %></td>
        <td><%= p.quantity %></td>
        <td><%= p.supplier.name %></td>
        <td>
          <a href="/products/edit/<%= p._id %>">Sửa</a> |
          <a href="/products/delete/<%= p._id %>">Xóa</a>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include("../partials/footer") %>
