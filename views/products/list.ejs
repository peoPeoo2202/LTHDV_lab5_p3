<%- include("../layout/header", { user: user }) %>

<h2>Danh sách sản phẩm</h2>
<a href="/products/add">Thêm sản phẩm</a>
<table border="1" cellpadding="5">
  <tr>
    <th>Tên</th>
    <th>Giá</th>
    <th>Số lượng</th>
    <th>Nhà cung cấp</th>
  </tr>
  <% products.forEach(p => { %>
  <tr>
    <td><%= p.name %></td>
    <td><%= p.price %></td>
    <td><%= p.quantity %></td>
    <td><%= p.supplierId.name %></td>
  </tr>
  <% }) %>
</table>

<%- include("../layout/footer") %>
